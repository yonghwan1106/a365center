# =====================================================
# a365center-preview · 환경변수 템플릿
# =====================================================
# 이 파일을 복사해서 .env.local 로 저장한 뒤 실제 값을 채우세요.
# .env.local 은 .gitignore에 의해 자동 제외됩니다 (커밋 금지)

# Google AI Studio (https://aistudio.google.com) 에서 발급받은 Gemini API 키
# ⚠ 절대 클라이언트 코드에 직접 박지 마세요. 이 파일을 통해서만 서버에서 사용됩니다.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# (선택) Gemini 모델 오버라이드. 미설정 시 gemini-2.0-flash 사용.
GEMINI_MODEL=gemini-2.5-flash

# Azure Speech 음성 서비스 (OST 똑똑이 선생님 음성 인식/출력)
# Azure Portal → 음성 서비스(a365-speech) → 키 및 엔드포인트에서 발급.
# ⚠ 절대 클라이언트 코드에 직접 박지 마세요. /api/speech-token 서버 라우트에서만 사용됩니다.
AZURE_SPEECH_KEY=YOUR_AZURE_SPEECH_KEY_HERE
# 리소스 지역 식별자 (예: koreacentral, eastus)
AZURE_SPEECH_REGION=koreacentral
